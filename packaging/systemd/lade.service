[Unit]
Description=LADE service (Objectives, Git authority and sandboxed agent workers)
Documentation=file://@DOCDIR@/user-guide.md

[Service]
Type=exec
ExecStart=@LADED@ serve
Environment=LADE_WORKER_DIR=@WORKER_DIR@
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
KillMode=control-group
Delegate=memory pids cpu
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=64 78
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=~@clock @cpu-emulation @module @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
