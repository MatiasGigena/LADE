#!/bin/sh
dir=$(dirname "$0")
mode=ok
[ -f "$dir/mode" ] && mode=$(cat "$dir/mode")
printf '%s\n' "$*" >> "$dir/calls"
env | cut -d= -f1 | sort > "$dir/env"
command=$1
shift
label=
if [ "$command" = store ] && [ "$1" = --label ]; then
    label=$2
    shift 2
fi
provider=
variable=
while [ $# -ge 2 ]; do
    case $1 in
        provider) provider=$2 ;;
        variable) variable=$2 ;;
    esac
    shift 2
done
case $mode in
    timeout) exec sleep 30 ;;
    unavailable)
        echo "secret-tool: The name org.freedesktop.secrets was not provided by any .service files" >&2
        exit 1
        ;;
esac
mkdir -p "$dir/store"
case $command in
    lookup)
        [ "$mode" = locked ] && exit 1
        [ -f "$dir/store/$provider.$variable" ] || exit 1
        cat "$dir/store/$provider.$variable"
        ;;
    search)
        if [ "$mode" = locked ]; then
            echo "secret-tool: Cannot get secret of a locked object" >&2
            printf '[/1]\nattribute.provider = %s\n' "$provider"
        fi
        ;;
    store)
        if [ "$mode" = locked ]; then
            echo "secret-tool: Cannot create an item in a locked collection" >&2
            exit 1
        fi
        cat > "$dir/store/$provider.$variable"
        printf '%s\n' "$label" > "$dir/label"
        ;;
    clear)
        found=1
        for item in "$dir/store/$provider."${variable:-*}; do
            if [ -f "$item" ]; then
                rm "$item"
                found=0
            fi
        done
        exit $found
        ;;
    *) exit 2 ;;
esac
