{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lade.local/contracts/v1/worker",
  "$comment": "Generated by scripts/generate-schema.py; do not edit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "bundle", "body"],
  "properties": {"protocol": {"const": 1}, "bundle": {"const": "0.2.0"}, "body": {"$ref": "#/$defs/WorkerBody"}},
  "$defs": {
    "Id": {"type": "string", "format": "uuid-v4"},
    "Counter": {"type": "string", "format": "u64"},
    "Model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "DeliveryMode": {"enum": ["prompt", "steer", "follow_up"]},
    "ActivityRole": {"enum": ["user", "assistant", "thinking", "tool", "system"]},
    "ThinkingLevel": {"enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]},
    "EntryId": {"type": "string", "minLength": 1, "maxLength": 64},
    "TreeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "kind", "label"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/EntryId"},
        "kind": {
          "enum": [
            "user",
            "assistant",
            "tool_result",
            "custom_message",
            "compaction",
            "branch_summary",
            "model_change",
            "thinking_change",
            "label",
            "session_info",
            "custom",
            "other"
          ]
        },
        "label": {"type": "string", "maxLength": 200},
        "parent_id": {"$ref": "#/$defs/EntryId"},
        "bookmark": {"type": "string", "maxLength": 200}
      }
    },
    "UiPrompt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "message"],
          "properties": {
            "kind": {"const": "confirm"},
            "title": {"type": "string", "maxLength": 512},
            "message": {"type": "string", "maxLength": 4096}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "options"],
          "properties": {
            "kind": {"const": "select"},
            "title": {"type": "string", "maxLength": 512},
            "options": {"type": "array", "items": {"type": "string", "maxLength": 512}, "maxItems": 64, "minItems": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "placeholder"],
          "properties": {
            "kind": {"const": "input"},
            "title": {"type": "string", "maxLength": 512},
            "placeholder": {"type": "string", "maxLength": 512}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "title", "prefill"],
          "properties": {
            "kind": {"const": "editor"},
            "title": {"type": "string", "maxLength": 512},
            "prefill": {"type": "string", "maxLength": 65536}
          }
        }
      ]
    },
    "UiAnswer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "confirmed"],
          "properties": {"kind": {"const": "confirm"}, "confirmed": {"type": "boolean"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "value"}, "value": {"type": "string", "maxLength": 65536}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "cancel"}}
        }
      ]
    },
    "UiCloseReason": {"enum": ["timeout", "aborted", "replaced", "answered"]},
    "SessionChangeReason": {"enum": ["start", "navigate", "fork", "import", "reload", "compact", "configure"]},
    "WorkerErrorCode": {
      "enum": [
        "startup_failed",
        "session_failed",
        "provider_failed",
        "delivery_failed",
        "protocol_violation",
        "limit_reached",
        "internal"
      ]
    },
    "WorkerExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"type": "string", "format": "sha256"}
      }
    },
    "WorkerResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_dir", "extensions"],
      "properties": {
        "profile_dir": {"type": "string", "minLength": 1, "maxLength": 4096},
        "extensions": {"type": "array", "items": {"$ref": "#/$defs/WorkerExtension"}, "maxItems": 64}
      }
    },
    "SessionCommand": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"const": "tree"}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "entry_id"],
          "properties": {"op": {"const": "navigate"}, "entry_id": {"$ref": "#/$defs/EntryId"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "entry_id", "position"],
          "properties": {"op": {"const": "fork"}, "entry_id": {"$ref": "#/$defs/EntryId"}, "position": {"enum": ["before", "at"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path"],
          "properties": {"op": {"const": "import"}, "path": {"type": "string", "minLength": 1, "maxLength": 4096}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path"],
          "properties": {"op": {"const": "export"}, "path": {"type": "string", "minLength": 1, "maxLength": 4096}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {"op": {"const": "compact"}, "instructions": {"type": "string", "maxLength": 4096}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "resources"],
          "properties": {"op": {"const": "reload"}, "resources": {"$ref": "#/$defs/WorkerResources"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "model", "thinking"],
          "properties": {
            "op": {"const": "configure"},
            "model": {"$ref": "#/$defs/Model"},
            "thinking": {"$ref": "#/$defs/ThinkingLevel"}
          }
        }
      ]
    },
    "LoadedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "source", "status"],
      "properties": {
        "kind": {"enum": ["skill", "prompt", "context", "extension"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "source": {"enum": ["lade_profile", "repository"]},
        "status": {"enum": ["loaded", "refused", "failed"]},
        "sha256": {"type": "string", "format": "sha256"},
        "message": {"type": "string", "maxLength": 512}
      }
    },
    "ServiceToWorker": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "objective_id", "session_dir", "cwd", "model", "resume", "system_note"],
          "properties": {
            "kind": {"const": "worker.start"},
            "objective_id": {"$ref": "#/$defs/Id"},
            "session_dir": {"type": "string", "minLength": 1, "maxLength": 4096},
            "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
            "model": {"$ref": "#/$defs/Model"},
            "resume": {"type": "boolean"},
            "system_note": {"type": "string"},
            "thinking": {"$ref": "#/$defs/ThinkingLevel"},
            "resources": {"$ref": "#/$defs/WorkerResources"},
            "session_file": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "input_id", "mode", "text"],
          "properties": {
            "kind": {"const": "input.deliver"},
            "input_id": {"$ref": "#/$defs/Id"},
            "mode": {"$ref": "#/$defs/DeliveryMode"},
            "text": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "session.abort"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "worker.shutdown"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command_id", "command"],
          "properties": {
            "kind": {"const": "session.command"},
            "command_id": {"$ref": "#/$defs/Id"},
            "command": {"$ref": "#/$defs/SessionCommand"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ui_id", "generation", "answer"],
          "properties": {
            "kind": {"const": "ui.respond"},
            "ui_id": {"$ref": "#/$defs/Id"},
            "generation": {"$ref": "#/$defs/Counter"},
            "answer": {"$ref": "#/$defs/UiAnswer"}
          }
        }
      ]
    },
    "WorkerToService": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pi_session_id", "session_file"],
          "properties": {
            "kind": {"const": "worker.ready"},
            "pi_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "session_file": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "input_id"],
          "properties": {"kind": {"const": "input.received"}, "input_id": {"$ref": "#/$defs/Id"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item_id", "role", "title", "text", "is_error", "truncated"],
          "properties": {
            "kind": {"const": "activity.item"},
            "item_id": {"$ref": "#/$defs/Id"},
            "role": {"$ref": "#/$defs/ActivityRole"},
            "title": {"type": "string", "maxLength": 1024},
            "text": {"type": "string"},
            "is_error": {"type": "boolean"},
            "truncated": {"type": "boolean"},
            "tool_name": {"type": "string", "maxLength": 256}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "item_id", "append_text"],
          "properties": {"kind": {"const": "activity.delta"}, "item_id": {"$ref": "#/$defs/Id"}, "append_text": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "state"],
          "properties": {"kind": {"const": "turn.state"}, "state": {"enum": ["running", "idle"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "code", "message"],
          "properties": {
            "kind": {"const": "worker.error"},
            "code": {"$ref": "#/$defs/WorkerErrorCode"},
            "message": {"type": "string", "maxLength": 512}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command_id", "ok", "message"],
          "properties": {
            "kind": {"const": "session.result"},
            "command_id": {"$ref": "#/$defs/Id"},
            "ok": {"type": "boolean"},
            "message": {"type": "string", "maxLength": 512},
            "entries": {"type": "array", "items": {"$ref": "#/$defs/TreeEntry"}, "maxItems": 1024},
            "leaf_id": {"$ref": "#/$defs/EntryId"},
            "truncated": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "generation", "reason", "pi_session_id", "session_file", "model", "thinking"],
          "properties": {
            "kind": {"const": "session.changed"},
            "generation": {"$ref": "#/$defs/Counter"},
            "reason": {"$ref": "#/$defs/SessionChangeReason"},
            "pi_session_id": {"type": "string", "minLength": 1, "maxLength": 256},
            "session_file": {"type": "string", "minLength": 1, "maxLength": 4096},
            "model": {"$ref": "#/$defs/Model"},
            "thinking": {"$ref": "#/$defs/ThinkingLevel"},
            "leaf_id": {"$ref": "#/$defs/EntryId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "generation", "resources"],
          "properties": {
            "kind": {"const": "resources.loaded"},
            "generation": {"$ref": "#/$defs/Counter"},
            "resources": {"type": "array", "items": {"$ref": "#/$defs/LoadedResource"}, "maxItems": 256}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ui_id", "generation", "prompt"],
          "properties": {
            "kind": {"const": "ui.request"},
            "ui_id": {"$ref": "#/$defs/Id"},
            "generation": {"$ref": "#/$defs/Counter"},
            "prompt": {"$ref": "#/$defs/UiPrompt"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ui_id", "reason"],
          "properties": {
            "kind": {"const": "ui.closed"},
            "ui_id": {"$ref": "#/$defs/Id"},
            "reason": {"$ref": "#/$defs/UiCloseReason"}
          }
        }
      ]
    },
    "WorkerBody": {"oneOf": [{"$ref": "#/$defs/ServiceToWorker"}, {"$ref": "#/$defs/WorkerToService"}]}
  }
}
