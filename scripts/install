#!/bin/sh
# Per-user LADE installation (no sudo, no network).
#
#   install [--prefix DIR] [--bundle DIR] [--node PATH] [--enable] [--no-sandbox-probe]
#   install --rollback [--prefix DIR] [--enable]
#
# Installs a bundle built by scripts/bundle into PREFIX (default ~/.local):
#   PREFIX/lib/lade/<id>/            verified copy of the bundle (MANIFEST.sha256 checked)
#   PREFIX/lib/lade/current          -> <id>        (activated version)
#   PREFIX/lib/lade/previous         -> <older id>  (kept for --rollback)
#   PREFIX/bin/{laded,lade-desktop}  launchers exec'ing PREFIX/lib/lade/current/bin/… with the
#                                    bundled worker (LADE_WORKER_DIR) and Node on PATH
#   PREFIX/share/applications/dev.lade.Lade.desktop, PREFIX/share/icons/…/dev.lade.Lade.svg
#   ${XDG_CONFIG_HOME:-~/.config}/systemd/user/lade.service
# Services are started only with --enable. User data (~/.local/state/lade) is never touched.
#
# --bundle      bundle directory (default: the bundle containing this script, else dist/lade-*)
# --node        Node 22 executable to record in the unit (default: node on PATH)
# --enable      systemctl --user daemon-reload, enable --now (or restart) lade.service
# --no-sandbox-probe  skip the functional bubblewrap probe (execution then fails closed at run
#                     time if the sandbox does not work; inspection still works)
# --rollback    switch current/previous and keep both directories
set -eu

die() { printf 'install: %s\n' "$*" >&2; exit 1; }
note() { printf 'install: %s\n' "$*"; }

[ -n "${HOME:-}" ] || die "HOME is not set"
prefix="$HOME/.local"
bundle=
node=
enable=0
probe=1
rollback=0
while [ $# -gt 0 ]; do
    case $1 in
        --prefix) [ $# -ge 2 ] || die "--prefix needs a directory"; prefix=$2; shift ;;
        --bundle) [ $# -ge 2 ] || die "--bundle needs a directory"; bundle=$2; shift ;;
        --node) [ $# -ge 2 ] || die "--node needs a path"; node=$2; shift ;;
        --enable) enable=1 ;;
        --no-sandbox-probe) probe=0 ;;
        --rollback) rollback=1 ;;
        -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
    shift
done
case $prefix in /*) ;; *) die "--prefix must be an absolute path" ;; esac
prefix=${prefix%/}
# Paths are written into a unit file, a desktop entry and shell launchers: keep them plain.
safe_path() { printf '%s' "$1" | grep -Eq '^/[A-Za-z0-9/._+-]*$'; }
safe_path "$prefix" || die "--prefix may contain only letters, digits and / . _ + -"

config_home=${XDG_CONFIG_HOME:-}
case $config_home in /*) ;; *) config_home="$HOME/.config" ;; esac
unit_dir="$config_home/systemd/user"
unit="$unit_dir/lade.service"
libdir="$prefix/lib/lade"
umask 022

# --- helpers ---------------------------------------------------------------------------------

version_field() { sed -n "s/^$2=//p" "$1/VERSION" | head -1; }

# Verify DIR against its MANIFEST.sha256: every listed file matches and no unlisted file exists.
verify_manifest() {
    [ -f "$1/MANIFEST.sha256" ] && [ -f "$1/VERSION" ] || { printf 'no MANIFEST.sha256/VERSION in %s\n' "$1" >&2; return 1; }
    (cd "$1" && sha256sum --check --strict --quiet MANIFEST.sha256) >&2 || return 1
    listed=$(sed 's/^[0-9a-f]\{64\}  //' "$1/MANIFEST.sha256" | LC_ALL=C sort)
    present=$(cd "$1" && find . ! -type d ! -path ./MANIFEST.sha256 | LC_ALL=C sort)
    [ "$listed" = "$present" ] && return 0
    printf 'files present but not in the manifest of %s:\n' "$1" >&2
    printf '%s\n' "$present" | while IFS= read -r f; do
        printf '%s\n' "$listed" | grep -Fxq -- "$f" || printf '  %s\n' "$f" >&2
    done
    return 1
}

# Replace symlink $2 by one pointing at $1 atomically (rename over the old link).
set_link() {
    ln -s "$1" "$2.new.$$"
    mv -fT "$2.new.$$" "$2"
}

systemctl_user() {
    command -v systemctl >/dev/null 2>&1 && systemctl --user "$@"
}

version_ge() { # version_ge 2.43.0 2.38 -> true
    printf '%s\n%s\n' "$2" "$1" | sort -V -C
}

# --- activation steps shared by install and rollback -------------------------------------------

activate_service() {
    if [ "$enable" = 1 ]; then
        systemctl_user daemon-reload || die "systemctl --user is not available; start laded manually (see the user guide)"
        if systemctl_user is-active --quiet lade.service; then
            systemctl_user restart lade.service
            note "restarted lade.service"
        else
            systemctl_user enable --now lade.service
            note "enabled and started lade.service"
        fi
    else
        if systemctl_user is-active --quiet lade.service 2>/dev/null; then
            note "lade.service is running the old version: systemctl --user daemon-reload && systemctl --user restart lade.service"
        else
            note "next: systemctl --user daemon-reload && systemctl --user enable --now lade.service"
        fi
        note "then start LADE from the applications menu or run $prefix/bin/lade-desktop"
    fi
}

if [ "$rollback" = 1 ]; then
    [ -L "$libdir/previous" ] || die "no previous version to roll back to in $libdir"
    old=$(readlink "$libdir/current") || die "no current version in $libdir"
    prev=$(readlink "$libdir/previous")
    [ -d "$libdir/$prev" ] || die "previous version directory $libdir/$prev is missing"
    verify_manifest "$libdir/$prev" || die "previous version $prev fails its manifest; refusing to activate it"
    set_link "$prev" "$libdir/current"
    set_link "$old" "$libdir/previous"
    printf '%s rollback %s -> %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$old" "$prev" >>"$libdir/install.log"
    note "rolled back: current = $prev, previous = $old"
    note "a database already migrated by the newer version is refused by the older service (exit 78) and left untouched"
    activate_service
    exit 0
fi

# --- locate and check the bundle ---------------------------------------------------------------

script_dir=$(cd "$(dirname "$0")" && pwd)
if [ -z "$bundle" ]; then
    if [ -f "$script_dir/VERSION" ]; then
        bundle=$script_dir
    else
        set -- "$script_dir"/../dist/lade-*
        [ $# -eq 1 ] && [ -d "$1" ] || die "no unique bundle in dist/; run scripts/bundle or pass --bundle"
        bundle=$1
    fi
fi
[ -d "$bundle" ] || die "bundle $bundle is not a directory"
bundle=$(cd "$bundle" && pwd)
verify_manifest "$bundle" || die "bundle $bundle does not match its MANIFEST.sha256; refusing to install"
id=$(version_field "$bundle" id)
bundle_version=$(version_field "$bundle" bundle)
protocol=$(version_field "$bundle" protocol)
node_pin=$(version_field "$bundle" node)
printf '%s' "$id" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$' || die "invalid bundle id '$id' in VERSION"
case $id in current|previous) die "invalid bundle id '$id'" ;; esac

# --- prerequisites (fail closed, all problems reported at once) --------------------------------

problems=
problem() { problems="$problems
  - $*"; }

[ "$(uname -sm)" = "Linux x86_64" ] || problem "supported platform is Linux x86_64 (found $(uname -sm))"

find_tool() { # PATH, then /usr/bin and /bin (the order laded uses)
    p=$(command -v "$1" 2>/dev/null) && [ -x "$p" ] && { printf '%s\n' "$p"; return 0; }
    for d in /usr/bin /bin; do [ -x "$d/$1" ] && { printf '%s\n' "$d/$1"; return 0; }; done
    return 1
}

if bwrap=$(find_tool bwrap); then
    if [ -u "$bwrap" ]; then
        problem "$bwrap is setuid; LADE needs unprivileged bubblewrap (user namespaces) and its unit sets NoNewPrivileges"
    elif [ "$probe" = 1 ] && ! "$bwrap" --unshare-all --die-with-parent --new-session \
            --ro-bind / / --proc /proc --dev /dev true 2>/dev/null; then
        problem "bubblewrap cannot create a sandbox here (unprivileged user namespaces denied?). LADE never runs agents unsandboxed; fix the host policy deliberately, or pass --no-sandbox-probe to install for inspection only"
    fi
else
    problem "bubblewrap (bwrap) not found: install the 'bubblewrap' package"
fi
find_tool prlimit >/dev/null || problem "prlimit not found: install 'util-linux'"
if git=$(find_tool git); then
    gv=$("$git" --version | sed -n 's/^git version \([0-9][0-9.]*\).*/\1/p')
    version_ge "${gv:-0}" 2.38 || problem "git ${gv:-unknown} is too old: 2.38 or newer is required"
else
    problem "git not found"
fi

if [ -z "$node" ]; then
    node=$(command -v node 2>/dev/null) || node=
fi
if [ -n "$node" ] && [ -x "$node" ]; then
    node=$(readlink -f "$node")
    nv=$("$node" --version 2>/dev/null | sed 's/^v//')
    case $nv in
        22.*) [ "$nv" = "$node_pin" ] || note "warning: Node $nv differs from the tested pin $node_pin" ;;
        *) problem "Node ${nv:-unknown} at $node: Node 22 is required (tested: $node_pin)" ;;
    esac
    node_dir=$(dirname "$node")
    safe_path "$node_dir" || problem "Node directory $node_dir contains characters LADE cannot write into its unit"
else
    problem "Node 22 not found on PATH (or pass --node /path/to/node)"
    node_dir=/usr/bin
fi

# GTK 4.14 and GtkSourceView 5.12 runtime libraries: every library resolves and, with immediate
# binding, every symbol the client uses exists (an older GTK fails here, not at first click).
missing=$(ldd "$bundle/bin/lade-desktop" 2>/dev/null | sed -n 's/^[[:space:]]*\([^ ]*\) => not found.*/\1/p' | tr '\n' ' ')
if [ -n "$missing" ]; then
    problem "missing runtime libraries for lade-desktop: $missing(install GTK 4.14+ and GtkSourceView 5.12+: libgtk-4-1, libgtksourceview-5-0)"
elif ! LD_BIND_NOW=1 "$bundle/bin/lade-desktop" --version >/dev/null 2>&1; then
    problem "lade-desktop cannot load its libraries (GTK older than 4.14 or GtkSourceView older than 5.12?)"
fi
"$bundle/bin/laded" --version 2>/dev/null | grep -q "^laded $bundle_version protocol $protocol\$" \
    || problem "bundled laded does not report bundle $bundle_version protocol $protocol"
if [ "$enable" = 1 ] && ! systemctl_user show-environment >/dev/null 2>&1; then
    problem "--enable needs a running systemd user manager (systemctl --user)"
fi

for exe in laded lade-desktop; do
    launcher="$prefix/bin/$exe"
    if [ -L "$launcher" ] || { [ -e "$launcher" ] \
            && ! sed -n 2p "$launcher" | grep -q '^# Installed by LADE scripts/install'; }; then
        problem "$launcher exists and was not written by the LADE installer; not replacing it"
    fi
done

[ -z "$problems" ] || die "prerequisites not met:$problems"

# --- stage, verify and activate ----------------------------------------------------------------

mkdir -p "$libdir" "$prefix/bin"
target="$libdir/$id"
if [ -e "$target" ]; then
    verify_manifest "$target" || die "$target exists but fails its manifest; remove it or roll back first"
    cmp -s "$target/MANIFEST.sha256" "$bundle/MANIFEST.sha256" \
        || die "$target exists with different content for the same id"
    note "version $id is already present; re-activating it"
else
    staging="$libdir/.staging.$$"
    rm -rf "$staging"
    trap 'rm -rf "$staging"' EXIT
    cp -R "$bundle" "$staging"
    # Verify the copy that will run, not only the source.
    verify_manifest "$staging" || die "the copied bundle does not match its manifest; nothing activated"
    chmod -R go-w "$staging"
    mv "$staging" "$target"
    trap - EXIT
fi

old=
[ -L "$libdir/current" ] && old=$(readlink "$libdir/current")
set_link "$id" "$libdir/current"
if [ -n "$old" ] && [ "$old" != "$id" ]; then
    set_link "$old" "$libdir/previous"
fi
# Keep only current and previous.
prev=
[ -L "$libdir/previous" ] && prev=$(readlink "$libdir/previous")
for d in "$libdir"/*; do
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    name=$(basename "$d")
    [ "$name" = "$id" ] || [ "$name" = "$prev" ] || { rm -rf "$d"; note "removed old version $name"; }
done
printf '%s install %s (previous %s)\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$id" "${prev:-none}" >>"$libdir/install.log"

current="$libdir/current"
# Launchers rather than bare symlinks: laded finds the bundled worker only through LADE_WORKER_DIR
# and Node through PATH, and lade-desktop may start laded itself (inheriting this environment) when
# the user unit is not running.
for exe in laded lade-desktop; do
    launcher="$prefix/bin/$exe"
    cat >"$launcher.new.$$" <<LAUNCHER
#!/bin/sh
# Installed by LADE scripts/install; re-run the installer to change it.
LADE_WORKER_DIR='$current/lib/lade/pi-worker'
PATH='$node_dir':\${PATH:-/usr/local/bin:/usr/bin:/bin}
export LADE_WORKER_DIR PATH
exec '$current/bin/$exe' "\$@"
LAUNCHER
    chmod 755 "$launcher.new.$$"
    mv -f "$launcher.new.$$" "$launcher"
done

apps="$prefix/share/applications"
icons="$prefix/share/icons/hicolor/scalable/apps"
mkdir -p "$apps" "$icons" "$unit_dir"
sed -e "s|^Exec=lade-desktop\$|Exec=$prefix/bin/lade-desktop|" \
    -e "s|^TryExec=lade-desktop\$|TryExec=$prefix/bin/lade-desktop|" \
    "$current/share/applications/dev.lade.Lade.desktop" >"$apps/dev.lade.Lade.desktop.new.$$"
mv -f "$apps/dev.lade.Lade.desktop.new.$$" "$apps/dev.lade.Lade.desktop"
cp "$current/share/icons/hicolor/scalable/apps/dev.lade.Lade.svg" "$icons/dev.lade.Lade.svg"

{
    printf '# Installed by LADE scripts/install (bundle %s). Re-run the installer to change it.\n' "$id"
    sed -e "s|@LADED@|$current/bin/laded|" \
        -e "s|@WORKER_DIR@|$current/lib/lade/pi-worker|" \
        -e "s|@NODE_DIR@|$node_dir|" \
        -e "s|@DOCDIR@|$current/share/doc/lade|" \
        "$current/share/systemd/user/lade.service.in"
} >"$unit.new.$$"
mv -f "$unit.new.$$" "$unit"

command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q "$apps" 2>/dev/null || true
command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -f "$prefix/share/icons/hicolor/index.theme" ] \
    && gtk-update-icon-cache -q "$prefix/share/icons/hicolor" 2>/dev/null || true

note "installed $id (node $node, worker $current/lib/lade/pi-worker)"
[ -z "$prev" ] || note "previous version $prev kept; scripts/install --rollback switches back"
note "unit: $unit"
case ":${PATH:-}:" in *":$prefix/bin:"*) ;; *) note "note: $prefix/bin is not on PATH" ;; esac
activate_service
