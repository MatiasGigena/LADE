#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
python3 scripts/check-pins.py --portable
python3 scripts/generate-schema.py --check
python3 scripts/generate-dtos.py --check
python3 scripts/generate-fixtures.py --check
./scripts/cargo fmt --all -- --check
./scripts/cargo build --workspace --locked
./scripts/cargo test --workspace --locked
./scripts/cargo clippy --workspace --all-targets --locked -- -D warnings
python3 scripts/check-architecture.py
python3 scripts/license-inventory.py --check
python3 scripts/check-contrast.py >/dev/null
npm --prefix packages/pi-worker run lint
python3 scripts/check-worker-lint.py
npm --prefix packages/pi-worker run check
npm --prefix packages/pi-worker test
python3 scripts/compare-fixtures.py
for script in scripts/bundle scripts/sign-bundle scripts/install scripts/uninstall scripts/test-install scripts/verify; do
    sh -n "$script"
done
./scripts/test-install
./target/debug/lade-desktop --version
./target/debug/laded --version
set +e
./target/debug/laded 2>/dev/null
status=$?
set -e
test "$status" = 64 || { echo "laded without a command did not print usage: $status" >&2; exit 1; }
smoke=$(mktemp -d)
trap 'rm -rf "$smoke"' EXIT
mkdir -m 777 "$smoke/run"
chmod 777 "$smoke/run"
set +e
./target/debug/laded serve --state-dir "$smoke/state" --runtime-dir "$smoke/run" 2>/dev/null
status=$?
set -e
test "$status" = 78 || { echo "service did not refuse an unsafe runtime dir: $status" >&2; exit 1; }
test ! -e "$smoke/run/control.sock" || { echo "service listened on an unsafe runtime dir" >&2; exit 1; }
