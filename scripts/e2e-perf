#!/bin/sh
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT=${1:-$ROOT/evidence-local/imp-010}
DPY=:${E2E_DISPLAY:-80}
N=${E2E_SAMPLES:-20}
SUFFIX=${GSK_RENDERER:+-$GSK_RENDERER}
BIN=$ROOT/target/release
W=1440
H=900
for tool in Xvfb xdotool import git bwrap python3; do
  command -v "$tool" >/dev/null || { echo "e2e-perf: $tool is required" >&2; exit 2; }
done
[ -x "$BIN/laded" ] && [ -x "$BIN/lade-desktop" ] || {
  echo "e2e-perf: build first: ./scripts/cargo build --release --workspace --locked" >&2
  exit 2
}
mkdir -p "$OUT"
T=$(mktemp -d /tmp/lperf.XXXXXX)
STATE=$T/state
RUN=$T/run
REPO=$T/repo
TRACE=$T/trace.log
LOG=$T/run.log
: >"$TRACE"; : >"$LOG"
pids=""
cleanup() {
  : >"$T/stop" 2>/dev/null || true
  for pid in $pids; do kill "$pid" 2>/dev/null || true; done
  wait 2>/dev/null || true
  [ "${E2E_KEEP:-0}" = 1 ] || rm -rf "$T"
}
trap cleanup EXIT INT TERM
fail() {
  echo "e2e-perf: FAILED: $*" | tee -a "$LOG" >&2
  import -window root "$T/failed.png" 2>/dev/null || true
  exit 1
}
step() { echo "e2e-perf: $*" | tee -a "$LOG"; }
phase() { echo "$1" >"$T/phase"; step "phase $1"; }
export DISPLAY=$DPY
x() { xdotool "$@"; }
click() { x mousemove "$1" "$2" click 1; sleep "${3:-1}"; }
key() { x key "$@"; sleep 1; }
typ() { x type --delay 8 "$1"; }
scroll_inspector() {
  x mousemove 1280 600
  n=$1; b=5
  [ "$n" -lt 0 ] && { n=$((0 - n)); b=4; }
  i=0; while [ $i -lt "$n" ]; do x click $b; i=$((i + 1)); done; sleep 1
}
find_button() {
  case $1 in
    primary) import -window root -depth 8 ppm:- | python3 -I "$ROOT/scripts/e2e-find-button.py" primary 1148 1383 100 900 ;;
    *) import -window root -depth 8 ppm:- |
      python3 -I "$ROOT/scripts/e2e-find-button.py" edge "$1" 1124 1411 100 900 ;;
  esac
}
click_start() {
  key ctrl+2
  tries=0
  until XY=$(import -window root -depth 8 ppm:- | python3 -I "$ROOT/scripts/e2e-find-button.py" box 270 1100 150 750); do
    tries=$((tries + 1)); [ $tries -le 40 ] || fail "no Start agent button"; sleep 0.5
  done
  click ${XY% *} ${XY#* } 1
}
click_inspector() {
  scroll_inspector -20
  tries=0
  while ! y=$(find_button "$2"); do
    tries=$((tries + 1))
    [ $tries -le 16 ] || fail "no enabled button for $1"
    scroll_inspector 2
  done
  click 1280 "$y" 1
}
wait_for() {
  limit=$1; what=$2; shift 2
  n=0
  while ! "$@" >/dev/null 2>&1; do
    n=$((n + 1))
    [ $n -le $((limit * 20)) ] || fail "timed out waiting for $what"
    sleep 0.05
  done
}
since() { tail -n +"$1" "$TRACE" | grep -q "$2"; }
lines() { wc -l <"$TRACE"; }
mono_ms() { python3 -I -c 'import time; print(int(time.clock_gettime(time.CLOCK_MONOTONIC) * 1000))'; }
wt() { for d in "$STATE"/worktrees/*; do [ -d "$d" ] && echo "$d" && return 0; done; return 1; }
wt_file_is() { d=$(wt) && [ "$(cat "$d/$1" 2>/dev/null)" = "$2" ]; }
session_ready() { ls "$STATE"/sessions/*/agent >/dev/null 2>&1; }
start_desktop() {
  echo "$(mono_ms) launch" >>"$TRACE"
  LADE_DESKTOP_TRACE=$TRACE XDG_CONFIG_HOME=$T/config GTK_A11Y=none \
    "$BIN/lade-desktop" --no-spawn --runtime-dir "$RUN" "$@" >>"$T/desktop.log" 2>&1 &
  DESKTOP=$!
  echo "$DESKTOP" >"$T/desktop.pid"
  pids="$pids $DESKTOP"
  wait_for 20 "LADE window" xdotool search --onlyvisible --name '^LADE$'
  WID=$(xdotool search --onlyvisible --name '^LADE$' | head -1)
  x windowmove "$WID" 0 0 windowsize "$WID" $W $H
  sleep 2
  click 700 60 0.5
}

step "development host, Xvfb ${W}x${H}, release build; not the supported Mint/Cinnamon/X11 host"
step "GTK renderer: ${GSK_RENDERER:-default (GL under Xvfb: Mesa software rendering)}"
step "host: $(uname -srm); $(nproc) CPUs; $(awk '/MemTotal/ {print $2 " kB"}' /proc/meminfo); GTK $(pkg-config --modversion gtk4 2>/dev/null || echo '?'); commit $(git -C "$ROOT" rev-parse --short HEAD)"
mkdir -p "$REPO" && mkdir -m 700 "$RUN"
git -C "$REPO" init -q -b main
git -C "$REPO" config user.email dev@example.com
git -C "$REPO" config user.name Developer
printf '# Demo\n' >"$REPO/README.md"
awk 'BEGIN { for (i = 0; i < 2000; i++) printf "old line %036d\n", i }' >"$REPO/c-ref-diff.txt"
git -C "$REPO" add README.md c-ref-diff.txt
git -C "$REPO" commit -q -m initial
Xvfb "$DPY" -screen 0 ${W}x${H}x24 -nolisten tcp >"$T/xvfb.log" 2>&1 &
pids="$pids $!"
sleep 1
LADE_WORKER_DIR=$ROOT/packages/pi-worker LADE_TEST_FIXTURE_PROVIDER=1 "$BIN/laded" serve --state-dir "$STATE" --runtime-dir "$RUN" >"$T/laded.log" 2>&1 &
LADED=$!
echo "$LADED" >"$T/laded.pid"
pids="$pids $LADED"
wait_for 10 "control socket" test -S "$RUN/control.sock"
phase launch
python3 -I "$ROOT/scripts/perf-sample.py" memory "$STATE" "$T" "$T/phase" "$T/memory.csv" &
pids="$pids $!"

step "warm launches (service running, Workspace known): $((N / 4)) samples"
start_desktop --open "$REPO"
i=1
while [ $i -lt $((N / 4)) ]; do
  python3 -I "$ROOT/scripts/x11-close-window.py" "$WID"
  wait_for 10 "window closed" sh -c "! kill -0 $DESKTOP 2>/dev/null"
  start_desktop
  i=$((i + 1))
done
phase idle-no-worker
sleep 30
python3 -I "$ROOT/scripts/perf-sample.py" cpu "$STATE" "$T" 60 "idle, window open, no worker" >>"$T/cpu.txt"

phase objective
key ctrl+n
typ "Reference trace"
key Tab
typ "one-worker reference workload"
key Tab Tab Tab Tab Tab Tab
key Return
sleep 2
click_start
wait_for 60 "sandboxed worker started" session_ready
sleep 5
phase idle-worker
python3 -I "$ROOT/scripts/perf-sample.py" cpu "$STATE" "$T" 60 "idle, one idle worker" >>"$T/cpu.txt"

phase input
key ctrl+2
click 680 790 0.3
typ "lade-fixture: write hello.txt hi"
key ctrl+Return
wait_for 60 "hello.txt" wt_file_is hello.txt hi
step "input → first agent activity: $N samples"
i=1
while [ $i -le "$N" ]; do
  mark=$(lines)
  click 680 790 0.2
  typ "lade-fixture: echo sample $i"
  x key ctrl+Return
  wait_for 30 "agent reply $i" since "$mark" " activity [0-9]* Assistant"
  sleep 1
  sleep 0.5
  i=$((i + 1))
done

phase reference-files
d=$(wt)
awk 'BEGIN { for (i = 0; i < 20000; i++) printf "%063d\n", i }' >"$d/b-ref.txt"
awk 'BEGIN { for (i = 0; i < 2000; i++) printf "new line %036d\n", i }' >"$d/c-ref-diff.txt"
awk 'BEGIN { for (i = 0; i < 19999; i++) printf "let value_%07d: u64 = %08d; // reference line %014d\n", i, i, i }' >"$d/a-ref.rs"
step "reference files: a-ref.rs $(wc -c <"$d/a-ref.rs") bytes, b-ref.txt $(wc -c <"$d/b-ref.txt") bytes, c-ref-diff.txt $(git -C "$d" diff --no-color c-ref-diff.txt | wc -l) diff lines / $(git -C "$d" diff --no-color c-ref-diff.txt | wc -c) bytes"
key ctrl+1
click 1057 265 3
ROW_A=277; ROW_B=333; ROW_C=389; ROW_H=445
click 920 277 1
step "Full file opens: $N × b-ref.txt (1,280,000 bytes), $((N / 2)) × a-ref.rs (highlighted), alternating with hello.txt"
i=1
while [ $i -le "$N" ]; do
  click 330 $ROW_B 1.5
  click 330 $ROW_H 1
  i=$((i + 1))
done
i=1
while [ $i -le $((N / 2)) ]; do
  click 330 $ROW_A 2.5
  click 330 $ROW_H 1
  i=$((i + 1))
done
click 330 $ROW_A 3
x mousemove 700 880; sleep 1
import -window root "$OUT/perf-highlighted-file$SUFFIX.png"
click 867 277 1
step "diff opens: $N × c-ref-diff.txt (4,000 lines), alternating with hello.txt"
i=1
while [ $i -le "$N" ]; do
  click 330 $ROW_C 1.5
  click 330 $ROW_H 1
  i=$((i + 1))
done

phase drafts
step "draft saves: $N single keystrokes, each waits for its acknowledgement"
x mousemove 622 358 click --repeat 2 --delay 80 1
sleep 1
key ctrl+shift+m
i=1
while [ $i -le "$N" ]; do
  mark=$(lines)
  typ "x"
  wait_for 10 "Saved r$i" since "$mark" "draft [0-9a-f]* Saved r$i\$"
  sleep 0.5
  i=$((i + 1))
done

phase review
click 1166 73 1
click_inspector "Freeze for review" primary
wait_for 60 "candidate" sh -c "git -C '$REPO' for-each-ref --format='%(subject)' refs/heads/lade/ | grep -q 'LADE candidate'"
sleep 3
click_inspector "Approve Candidate 1" outline
typ "Reference trace: no check configured."
key Tab Tab
key Return
sleep 2
click_inspector "Integrate into main" primary
key Tab
key Return
wait_for 60 "integration" sh -c "git -C '$REPO' log -1 --format=%s main | grep -q 'Reference trace'"
sleep 3
phase idle-after
python3 -I "$ROOT/scripts/perf-sample.py" cpu "$STATE" "$T" 30 "idle after integration (window open, worker stopped by freeze)" >>"$T/cpu.txt"

: >"$T/stop"
sleep 2
python3 -I "$ROOT/scripts/perf-report.py" "$TRACE" "$T/memory.csv" "$T/cpu.txt" >"$OUT/perf-report$SUFFIX.txt"
cp "$TRACE" "$OUT/perf-trace$SUFFIX.log"
cp "$T/memory.csv" "$OUT/perf-memory$SUFFIX.csv"
cp "$T/cpu.txt" "$OUT/perf-cpu$SUFFIX.txt"
step "PASSED; report in $OUT/perf-report$SUFFIX.txt"
cp "$LOG" "$OUT/perf-run$SUFFIX.log"
