#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
root=$PWD

die() { printf 'test-install: FAIL: %s\n' "$*" >&2; exit 1; }
ok() { printf 'test-install: ok: %s\n' "$*"; }

real=
real_signers=
usage="usage: scripts/test-install [--bundle DIR [--allowed-signers FILE]]"
case ${1:-} in
    --bundle)
        [ $# -eq 2 ] || { [ $# -eq 4 ] && [ "$3" = --allowed-signers ]; } || die "$usage"
        real=$(cd "$2" && pwd)
        [ $# -eq 2 ] || real_signers=$(cd "$(dirname "$4")" && pwd)/$(basename "$4")
        ;;
    '') ;;
    *) die "$usage" ;;
esac

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export HOME="$work/home"
unset XDG_CONFIG_HOME XDG_STATE_HOME XDG_DATA_HOME
mkdir -p "$HOME"
prefix="$work/prefix"
libdir="$prefix/lib/lade"
unit="$HOME/.config/systemd/user/lade.service"

manifest() {
    (cd "$1" && find . -type f ! -path ./MANIFEST.sha256 ! -path ./MANIFEST.sha256.sig -print0 \
        | LC_ALL=C sort -z | xargs -0 sha256sum --) >"$work/manifest"
    mv "$work/manifest" "$1/MANIFEST.sha256"
}
set_id() { sed -i "s/^id=.*/id=$2/" "$1/VERSION"; }

stub_laded() {
    cat >"$2" <<STUB
#!/bin/sh
state="\${XDG_STATE_HOME:-\$HOME/.local/state}/lade"
case "\$1 \${2:-}" in
    "--version ") echo "laded $bv protocol $pv" ;;
    "store info")
        echo "supported_schema=$1"
        echo "database=\$state/lade.db"
        if [ -f "\$state/lade.db" ]; then echo "database_schema=\$(cat "\$state/lade.db")"; else echo "database_schema=absent"; fi
        [ ! -f "\$state/backups.stub" ] || cat "\$state/backups.stub" ;;
    "store restore")
        [ ! -e "\$state/held" ] || { echo "laded: a LADE service is using the state directory" >&2; exit 75; }
        grep -q "^backup schema=\$4 " "\$state/backups.stub" 2>/dev/null || exit 1
        mv "\$state/lade.db" "\$state/lade.db.newer"
        echo "\$4" >"\$state/lade.db"
        echo "restored schema \$4" ;;
    *) exit 64 ;;
esac
STUB
    chmod 755 "$2"
}

json_field() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$1" "$2"; }
bv=$(json_field contracts/toolchain.json bundle)
pv=$(json_field contracts/toolchain.json protocol)

if [ -n "$real" ]; then
    b1="$work/b1"
    cp -R "$real" "$b1"
else
    b1="$work/b1"
    mkdir -p "$b1/bin" "$b1/lib/lade/pi-worker/src" "$b1/share/applications" \
        "$b1/share/icons/hicolor/scalable/apps" "$b1/share/systemd/user" "$b1/share/doc/lade" "$b1/share/fonts/lade"
    stub_laded 1 "$b1/bin/laded"
    printf '#!/bin/sh\necho "LADE %s protocol %s"\n' "$bv" "$pv" >"$b1/bin/lade-desktop"
    chmod 755 "$b1/bin/laded" "$b1/bin/lade-desktop"
    printf '// stub\n' >"$b1/lib/lade/pi-worker/src/worker.ts"
    cp scripts/install scripts/uninstall "$b1/"
    cp packaging/desktop/dev.lade.Lade.desktop "$b1/share/applications/"
    cp packaging/icons/dev.lade.Lade.svg "$b1/share/icons/hicolor/scalable/apps/"
    cp packaging/systemd/lade.service "$b1/share/systemd/user/lade.service.in"
    cp packaging/fonts/*.ttf "$b1/share/fonts/lade/"
    printf 'stub\n' >"$b1/share/doc/lade/user-guide.md"
    printf 'id=%s+test1\nbundle=%s\nprotocol=%s\nnode=22.23.1\nschema=1\nsigned=no\n' "$bv" "$bv" "$pv" >"$b1/VERSION"
    manifest "$b1"
fi
id1=$(sed -n 's/^id=//p' "$b1/VERSION")
b2="$work/b2"
cp -R "$b1" "$b2"
set_id "$b2" "$id1-second"
if [ -z "$real" ]; then
    stub_laded 2 "$b2/bin/laded"
    sed -i 's/^schema=.*/schema=2/' "$b2/VERSION"
fi
manifest "$b2"
id2="$id1-second"

probe=
bwrap --unshare-all --die-with-parent --new-session --ro-bind / / --proc /proc --dev /dev true 2>/dev/null \
    || probe=--no-sandbox-probe

try_install() { "$b1/install" --prefix "$prefix" $probe "$@" >"$work/out" 2>&1; }
run_install() { try_install "$@" || { cat "$work/out" >&2; return 1; }; }

bad="$work/bad"
cp -R "$b1" "$bad"
printf 'tampered\n' >>"$bad/lib/lade/pi-worker/src/worker.ts"
if try_install --bundle "$bad"; then die "tampered bundle was installed"; fi
grep -q 'does not match its MANIFEST' "$work/out" || die "tamper refusal message: $(cat "$work/out")"
[ ! -e "$libdir" ] || die "tampered bundle left files in $libdir"
rm -rf "$bad"; cp -R "$b1" "$bad"; printf 'x\n' >"$bad/bin/extra"
if try_install --bundle "$bad"; then die "bundle with an unlisted file was installed"; fi
grep -q 'bin/extra' "$work/out" || die "extra-file refusal does not name the file"
ok "tampered and extended bundles refused, nothing written"

if [ -z "$real" ] && command -v ssh-keygen >/dev/null 2>&1; then
    keys="$work/keys"
    mkdir -m 700 "$keys"
    ssh-keygen -q -t ed25519 -N '' -C release -f "$keys/release"
    ssh-keygen -q -t ed25519 -N '' -C other -f "$keys/other"
    printf 'release@lade namespaces="lade-release" %s\n' "$(cat "$keys/release.pub")" >"$keys/allowed"
    chmod 600 "$keys/allowed"
    sp="$work/psig"
    sig_install() { "$b1/install" --prefix "$sp" $probe "$@" >"$work/out" 2>&1; }
    bs="$work/bs"
    cp -R "$b1" "$bs"; set_id "$bs" "$id1-signed"; manifest "$bs"
    ./scripts/sign-bundle "$bs" "$keys/release" >/dev/null || die "sign-bundle"
    grep -qx 'signed=yes' "$bs/VERSION" && grep -q '^signer=SHA256:' "$bs/VERSION" || die "signed VERSION"
    [ -f "$bs/MANIFEST.sha256.sig" ] || die "no signature written"
    bw="$work/bw"
    cp -R "$b1" "$bw"; set_id "$bw" "$id1-wrongkey"; manifest "$bw"
    ./scripts/sign-bundle "$bw" "$keys/other" >/dev/null || die "sign-bundle (other key)"
    if sig_install --bundle "$bw" --allowed-signers "$keys/allowed"; then die "bundle signed by a foreign key was installed"; fi
    grep -q 'is not by a key in' "$work/out" || die "foreign-key refusal: $(cat "$work/out")"
    bt="$work/bt"
    cp -R "$bs" "$bt"
    printf 'tampered\n' >>"$bt/lib/lade/pi-worker/src/worker.ts"
    manifest "$bt"
    if sig_install --bundle "$bt" --allowed-signers "$keys/allowed"; then die "re-manifested tampered bundle was installed"; fi
    grep -q 'BAD signature' "$work/out" || die "bad-signature refusal: $(cat "$work/out")"
    bu="$work/bu"
    cp -R "$b1" "$bu"; rm -f "$bu/MANIFEST.sha256.sig"
    if sig_install --bundle "$bu" --allowed-signers "$keys/allowed"; then die "unsigned bundle installed despite a trust root"; fi
    grep -q 'not signed but a trust root is configured' "$work/out" || die "unsigned refusal: $(cat "$work/out")"
    [ ! -e "$sp/lib" ] && [ ! -e "$unit" ] || die "a refused signature check wrote files"
    sig_install --bundle "$bs" --allowed-signers "$keys/allowed" || { cat "$work/out" >&2; die "signed install"; }
    grep -q 'signature verified: release@lade' "$work/out" || die "verification not reported"
    sig_install --bundle "$bs" || { cat "$work/out" >&2; die "signed install without trust root"; }
    grep -q 'signature was NOT verified' "$work/out" || die "untrusted signature not warned"
    mkdir -p "$HOME/.config/lade"
    cp "$keys/allowed" "$HOME/.config/lade/allowed_signers"
    chmod 620 "$HOME/.config/lade/allowed_signers"
    if sig_install --bundle "$bs"; then die "group-writable trust root accepted"; fi
    grep -q 'writable by group or others' "$work/out" || die "trust-root mode refusal: $(cat "$work/out")"
    chmod 600 "$HOME/.config/lade/allowed_signers"
    sig_install --bundle "$bs" || { cat "$work/out" >&2; die "install with the configured trust root"; }
    grep -q 'signature verified: release@lade' "$work/out" || die "configured trust root not used"
    rm "$HOME/.config/lade/allowed_signers"
    "$sp/lib/lade/current/uninstall" --prefix "$sp" >/dev/null 2>&1 || die "uninstall of the signed test install"
    rm -rf "$bs" "$bw" "$bt" "$bu"
    ok "signatures: verified, foreign key, re-manifested tamper and unsigned-with-trust-root refused, untrusted signature warned, configured trust root and its mode"
else
    [ -n "$real" ] || printf 'test-install: skip: ssh-keygen not available (signature checks)\n'
fi

if [ -n "$real_signers" ]; then
    pr="$work/preal"
    "$b1/install" --prefix "$pr" $probe --bundle "$b1" --allowed-signers "$real_signers" >"$work/out" 2>&1 \
        || { cat "$work/out" >&2; die "the real bundle's signature does not verify"; }
    grep -q 'signature verified' "$work/out" || die "real bundle verification not reported"
    "$pr/lib/lade/current/uninstall" --prefix "$pr" >/dev/null 2>&1 || die "uninstall of the verified real install"
    ok "the real bundle's signature verifies against $real_signers"
fi

if [ -z "$real" ]; then
    bn="$work/bn"
    pn="$work/pnode"
    cp -R "$b1" "$bn"; set_id "$bn" "$id1-node"
    mkdir -p "$bn/lib/lade/node/bin"
    printf '#!/bin/sh\necho v22.1.0\n' >"$bn/lib/lade/node/bin/node"
    chmod 755 "$bn/lib/lade/node/bin/node"
    manifest "$bn"
    if "$b1/install" --prefix "$pn" $probe --bundle "$bn" >"$work/out" 2>&1; then die "bundled Node off the pin was accepted"; fi
    grep -q 'bundled Node reports 22.1.0' "$work/out" || die "bundled Node refusal: $(cat "$work/out")"
    printf '#!/bin/sh\necho v22.23.1\n' >"$bn/lib/lade/node/bin/node"
    manifest "$bn"
    "$b1/install" --prefix "$pn" $probe --bundle "$bn" >"$work/out" 2>&1 || { cat "$work/out" >&2; die "install with bundled Node"; }
    grep -q "^PATH='$pn/lib/lade/current/lib/lade/node/bin':" "$pn/bin/laded" || die "launcher does not use the bundled Node"
    grep -qx "Environment=PATH=$pn/lib/lade/current/lib/lade/node/bin:/usr/local/bin:/usr/bin:/bin" "$unit" \
        || die "unit does not use the bundled Node"
    "$pn/lib/lade/current/uninstall" --prefix "$pn" >/dev/null 2>&1 || die "uninstall of the bundled-Node test install"
    rm -rf "$bn"
    ok "bundled Node: off-pin runtime refused, launchers and unit prefer the bundled runtime"
fi

run_install --bundle "$b1" || die "install of $id1 failed"
[ "$(readlink "$libdir/current")" = "$id1" ] || die "current is not $id1"
[ ! -e "$libdir/previous" ] || die "previous exists after the first install"
for exe in laded lade-desktop; do
    grep -qx "exec '$libdir/current/bin/$exe' \"\$@\"" "$prefix/bin/$exe" || die "$exe launcher target"
    grep -qx "LADE_WORKER_DIR='$libdir/current/lib/lade/pi-worker'" "$prefix/bin/$exe" || die "$exe launcher worker dir"
done
"$prefix/bin/lade-desktop" --version | grep -q "^LADE $bv protocol $pv\$" || die "installed lade-desktop --version"
"$prefix/bin/laded" --version | grep -q "^laded $bv protocol $pv\$" || die "installed laded --version"
grep -q '@[A-Z_]*@' "$unit" && die "unresolved placeholder in $unit"
grep -qx "ExecStart=$libdir/current/bin/laded serve" "$unit" || die "ExecStart in $unit"
grep -qx "Environment=LADE_WORKER_DIR=$libdir/current/lib/lade/pi-worker" "$unit" || die "LADE_WORKER_DIR in $unit"
grep -qx 'KillMode=control-group' "$unit" || die "KillMode"
grep -qx "Exec=$prefix/bin/lade-desktop" "$prefix/share/applications/dev.lade.Lade.desktop" || die "desktop Exec"
[ -f "$prefix/share/icons/hicolor/scalable/apps/dev.lade.Lade.svg" ] || die "icon"
[ -f "$prefix/share/fonts/lade/InstrumentSans-Variable.ttf" ] && [ -f "$prefix/share/fonts/lade/FragmentMono-Regular.ttf" ] \
    || die "fonts"
grep -q 'next: systemctl --user' "$work/out" || die "next steps not printed"
grep -Eq 'this bundle is NOT signed|signature was NOT verified' "$work/out" || die "missing trust not warned"
ok "install $id1: launchers, unit, desktop entry and icon"
printf 'mine\n' >"$work/foreign"
mkdir -p "$work/p2/bin" && cp "$work/foreign" "$work/p2/bin/laded"
if "$b1/install" --prefix "$work/p2" $probe --bundle "$b1" >"$work/out" 2>&1; then die "replaced a foreign $work/p2/bin/laded"; fi
cmp -s "$work/foreign" "$work/p2/bin/laded" || die "foreign laded was modified"
[ ! -e "$work/p2/lib" ] || die "refused install wrote $work/p2/lib"
ok "a foreign $work/p2/bin/laded is refused before anything is written"

if command -v systemd-analyze >/dev/null 2>&1; then
    if systemd-analyze verify "$unit" >"$work/verify" 2>&1 && ! grep -q 'lade\.service' "$work/verify"; then
        ok "systemd-analyze verify $unit"
    else
        cat "$work/verify" >&2
        die "systemd-analyze verify rejected the unit"
    fi
else
    printf 'test-install: skip: systemd-analyze not available\n'
fi

run_install --bundle "$b2" || die "install of $id2 failed"
[ "$(readlink "$libdir/current")" = "$id2" ] && [ "$(readlink "$libdir/previous")" = "$id1" ] \
    || die "after second install: current=$(readlink "$libdir/current") previous=$(readlink "$libdir/previous")"
"$libdir/current/install" --rollback --prefix "$prefix" >"$work/out" 2>&1 || { cat "$work/out" >&2; die "rollback"; }
[ "$(readlink "$libdir/current")" = "$id1" ] && [ "$(readlink "$libdir/previous")" = "$id2" ] || die "after rollback"
printf 'tampered\n' >>"$libdir/$id2/VERSION"
if "$libdir/current/install" --rollback --prefix "$prefix" >"$work/out" 2>&1; then die "rollback to a tampered version"; fi
[ "$(readlink "$libdir/current")" = "$id1" ] || die "failed rollback changed current"
sed -i '$d' "$libdir/$id2/VERSION"
"$libdir/current/install" --rollback --prefix "$prefix" >"$work/out" 2>&1 || { cat "$work/out" >&2; die "second rollback"; }
[ "$(readlink "$libdir/current")" = "$id2" ] || die "after second rollback"
ok "second version, rollback, tampered rollback refused, roll forward"

if [ -z "$real" ]; then
    st="$HOME/.local/state/lade"
    mkdir -p "$st"
    echo 2 >"$st/lade.db"
    rollback() { "$libdir/current/install" --rollback --prefix "$prefix" "$@" >"$work/out" 2>&1; }
    if rollback --yes; then die "rollback across a schema change without a backup"; fi
    grep -q 'no pre-migration backup of schema 1' "$work/out" || die "missing-backup refusal: $(cat "$work/out")"
    [ "$(readlink "$libdir/current")" = "$id2" ] || die "refused rollback changed current"
    printf 'backup schema=1 to=2 taken=2026-01-01T00:00:00.000Z file=%s/backups/x.bak\n' "$st" >"$st/backups.stub"
    if setsid -w "$libdir/current/install" --rollback --prefix "$prefix" </dev/null >"$work/out" 2>&1; then
        die "database restore without a confirmation"
    fi
    grep -q 'needs confirmation' "$work/out" || die "confirmation refusal: $(cat "$work/out")"
    touch "$st/held"
    if rollback --yes; then die "restore while a service holds the state"; fi
    grep -q 'still uses' "$work/out" || die "busy refusal: $(cat "$work/out")"
    rm "$st/held"
    [ "$(readlink "$libdir/current")" = "$id2" ] && [ "$(cat "$st/lade.db")" = 2 ] || die "refused restores changed state"
    rollback --yes || { cat "$work/out" >&2; die "rollback with restore"; }
    grep -q 'restores the pre-migration backup taken 2026-01-01T00:00:00.000Z' "$work/out" || die "restore not explained"
    [ "$(readlink "$libdir/current")" = "$id1" ] && [ "$(cat "$st/lade.db")" = 1 ] && [ -f "$st/lade.db.newer" ] \
        || die "after the restore rollback"
    grep -q "restore schema 1 (database was 2) for rollback $id2 -> $id1" "$libdir/install.log" || die "restore not logged"
    rollback --yes || { cat "$work/out" >&2; die "roll forward after a restore"; }
    [ "$(readlink "$libdir/current")" = "$id2" ] && [ "$(cat "$st/lade.db")" = 1 ] || die "roll forward restored something"
    rm -rf "$st"
    ok "rollback across a schema change: missing backup, unconfirmed and busy restores refused; restore then roll forward"
fi

serve_check() {
    label=$1; shift
    state="$work/state-$label"; run="$work/run-$label"
    "$@" serve --state-dir "$state" --runtime-dir "$run" 2>"$work/laded.err" &
    pid=$!
    i=0
    while [ ! -S "$run/control.sock" ] && [ $i -lt 100 ]; do i=$((i + 1)); sleep 0.1; done
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    [ -S "$run/control.sock" ] || { cat "$work/laded.err" >&2; die "$label: installed laded did not listen"; }
    if grep -q 'launcher unavailable' "$work/laded.err"; then
        cat "$work/laded.err" >&2
        die "$label: installed laded could not construct the sandboxed launcher"
    fi
    ok "$label: installed laded serves with the bundled worker and Node"
}
if [ -n "$real" ]; then
    envline() { sed -n "s/^Environment=$1=//p" "$unit"; }
    serve_check unit env -i HOME="$HOME" LADE_WORKER_DIR="$(envline LADE_WORKER_DIR)" PATH="$(envline PATH)" \
        "$(sed -n 's/^ExecStart=\(.*\) serve$/\1/p' "$unit")"
    serve_check launcher env -i HOME="$HOME" PATH=/usr/bin:/bin "$prefix/bin/laded"
fi

mkdir -p "$HOME/.local/state/lade"
printf 'precious\n' >"$HOME/.local/state/lade/lade.db"
"$libdir/current/uninstall" --prefix "$prefix" >"$work/out" 2>&1 || { cat "$work/out" >&2; die "uninstall"; }
[ ! -e "$libdir" ] && [ ! -e "$prefix/bin/laded" ] && [ ! -e "$prefix/bin/lade-desktop" ] && [ ! -e "$unit" ] \
    && [ ! -e "$prefix/share/applications/dev.lade.Lade.desktop" ] && [ ! -e "$prefix/share/fonts/lade" ] \
    || die "uninstall left files"
[ -f "$HOME/.local/state/lade/lade.db" ] || die "uninstall deleted user data"
if setsid -w "$root/scripts/uninstall" --prefix "$prefix" --purge-data </dev/null >"$work/out" 2>&1; then
    die "purge without a terminal succeeded"
fi
grep -q 'needs an interactive terminal' "$work/out" || die "purge refusal message: $(cat "$work/out")"
[ -f "$HOME/.local/state/lade/lade.db" ] || die "refused purge deleted user data"
ok "uninstall removed the installation and kept $HOME/.local/state/lade; purge without a terminal refused"
printf 'test-install: all checks passed\n'
